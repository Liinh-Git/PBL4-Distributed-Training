# ==============================================================================
# HƯỚNG DẪN CẤU HÌNH NHANH THEO 2 TRƯỜNG HỢP:
#
# TRƯỜNG HỢP 1: TẤT CẢ CHẠY TRÊN 1 MÁY (Localhost)
#   - RUNTIME_HOST=127.0.0.1
#   - BACKEND_HOST=127.0.0.1
#   - PBL4_BACKEND_URL=http://127.0.0.1:8000
#   (Không cần cấu hình RUNTIME_ADVERTISED_HOST hay BACKEND_ADVERTISED_HOST)
#
# TRƯỜNG HỢP 2: CHẠY PHÂN TÁN NHIỀU MÁY (Multi-machine LAN / Cluster)
#   * Trên máy Master (chạy Backend + Runtime - giả sử IP LAN: 192.168.1.59):
#       - BACKEND_HOST=0.0.0.0          (để lắng nghe kết nối từ máy khác trong LAN)
#       - RUNTIME_HOST=127.0.0.1        (Backend kết nối nội bộ với Runtime)
#       - RUNTIME_ADVERTISED_HOST=192.168.1.59  (BẮT BUỘC: để Worker các máy kết nối DTP/1)
#       - BACKEND_ADVERTISED_HOST=192.168.1.59  (để WebUI / Node Agent kết nối vào Backend)
#
#   * Trên các máy Worker (chỉ chạy Node Agent + Worker):
#       - PBL4_BACKEND_URL=http://192.168.1.59:8000  (trỏ về IP của máy Master)
# ==============================================================================

# Base directory for runtime artifacts (checkpoints, logs, caches)
HOME=.var

# ─── Runtime (Parameter Server) ───────────────────────────────────
RUNTIME_HOST=127.0.0.1
RUNTIME_PORT=9000
RUNTIME_MANAGEMENT_PORT=9001
# Multi-machine required: LAN/Public IP of Runtime host advertised to workers in join-spec
# RUNTIME_ADVERTISED_HOST=192.168.1.59

# ─── Management Backend & Database ───────────────────────────────
# Single-machine: 127.0.0.1 | Multi-machine: 0.0.0.0
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# External IP/Domain advertised to WebUI and remote Node Agents if backend binds to 0.0.0.0
# BACKEND_ADVERTISED_HOST=192.168.1.59

# Database DSN used by Management Backend and Alembic migration tooling.
DATABASE_URL=postgresql://user:password@localhost:5432/distributed-training

# ─── Node Agent ──────────────────────────────────────────────────
# Single-machine: http://127.0.0.1:8000 | Multi-machine: http://<MASTER_IP>:8000
PBL4_BACKEND_URL=http://127.0.0.1:8000

# ─── Redis Config ────────────────────────────────────────────────
REDIS_URL=
REDIS_EVENT_STREAM=pbl4:runtime-events

# ─── Dataset Manager ─────────────────────────────────────────────
DATASET_MANAGER_URL=http://127.0.0.1:9200

# ─── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── Manifest & Admission Secrets ────────────────────────────────
CANONICAL_PARAMETER_MANIFEST_HASH=
PBL4_WORKER_ADMISSION_SECRET=
