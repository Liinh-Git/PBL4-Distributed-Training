# ─── PBL4 Environment Configuration ───────────────────────
# Copy this file to .env and configure for your local environment.

# Base directory for runtime artifacts (checkpoints, logs, caches)
PBL4_HOME=.var

# ─── Runtime (Parameter Server) ───────────────────────────
PBL4_RUNTIME_HOST=127.0.0.1
PBL4_RUNTIME_PORT=
PBL4_RUNTIME_MANAGEMENT_PORT=

# ─── Management Backend ───────────────────────────────────
PBL4_BACKEND_HOST=127.0.0.1
PBL4_BACKEND_PORT=
PBL4_DATABASE_URL=postgresql://user:password@localhost:5432/pbl4_db

# ─── Dataset Manager ─────────────────────────────────────
PBL4_DATASET_MANAGER_HOST=127.0.0.1
PBL4_DATASET_MANAGER_PORT=

# ─── Logging ──────────────────────────────────────────────
PBL4_LOG_LEVEL=INFO
