# ─── Environment Configuration ────────────────────────────────
# Copy this file to .env and configure for your local environment.

# Base directory for runtime artifacts (checkpoints, logs, caches)
HOME=.var

# ─── Runtime (Parameter Server) ───────────────────────────
RUNTIME_HOST=127.0.0.1
RUNTIME_PORT=9000
RUNTIME_MANAGEMENT_PORT=9100
# Optional: override ps_host in worker join-spec if workers reach runtime via a different address
# RUNTIME_ADVERTISED_HOST=192.168.1.10

# ─── Management Backend & Database ───────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Database DSN used by Management Backend and Alembic migration tooling.
DATABASE_URL=postgresql://user:password@localhost:5432/distributed-training

# ─── Dataset Manager ─────────────────────────────────────
DATASET_MANAGER_URL=http://127.0.0.1:9200

# ─── Logging ──────────────────────────────────────────────
LOG_LEVEL=INFO
