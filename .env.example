# ─── Environment Configuration ────────────────────────────────
# Copy this file to .env and configure for your local environment.

# Base directory for runtime artifacts (checkpoints, logs, caches)
HOME=.var

# ─── Runtime (Parameter Server) ───────────────────────────
RUNTIME_HOST=127.0.0.1
RUNTIME_PORT=
RUNTIME_MANAGEMENT_PORT=

# ─── Management Backend & Database ───────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=
# Canonical database DSN used by both Management Backend (psycopg) and Alembic migration tooling.
# Note: Alembic reads DATABASE_URL directly from the active shell/process environment;
# Alembic does not automatically parse .env files.
DATABASE_URL=postgresql://user:password@localhost:5432/distributed-training

# ─── Dataset Manager ─────────────────────────────────────
# Canonical external Dataset Manager URL (e.g. standalone service or Render Web Service)
DATASET_MANAGER_URL=http://127.0.0.1:9200
# Legacy fallback (used only if DATASET_MANAGER_URL is unset)
# DATASET_MANAGER_HOST=127.0.0.1
# DATASET_MANAGER_PORT=9200

# ─── Logging ──────────────────────────────────────────────
LOG_LEVEL=INFO
