# Management Backend — Environment Configuration Example
# Copy to .env and fill in real values before running.

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL DSN. Required. No default — must be explicitly configured.
DATABASE_URL=postgresql://user:password@localhost:5432/pbl4_db

# ─── Server ───────────────────────────────────────────────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ─── Runtime (MCP/1 gateway) ──────────────────────────────────────────────────
# Address of the Runtime Parameter Server MCP/1 management endpoint.
RUNTIME_HOST=127.0.0.1
RUNTIME_MANAGEMENT_PORT=9000

# ─── Dataset Manager ──────────────────────────────────────────────────────────
DATASET_MANAGER_HOST=127.0.0.1
DATASET_MANAGER_PORT=8100

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for CORS.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
