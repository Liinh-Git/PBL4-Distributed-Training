# Management Backend — Environment Configuration Example
# Copy to .env and fill in real values before running.

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL DSN. Required.
DATABASE_URL=postgresql://user:password@localhost:5432/pbl4_db

# ─── Server ───────────────────────────────────────────────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ─── Runtime (MCP/1 & DTP/1) ──────────────────────────────────────────────────
RUNTIME_HOST=127.0.0.1
RUNTIME_PORT=9000
RUNTIME_MANAGEMENT_PORT=9100
# Optional: override ps_host in worker join-spec if workers reach runtime via a different address
# RUNTIME_ADVERTISED_HOST=192.168.1.10

# ─── Dataset Manager ──────────────────────────────────────────────────────────
DATASET_MANAGER_URL=http://127.0.0.1:9200

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
